{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MoRead 主窗口默认能力。按最小权限原则：不开放任意 fs 读写，文件内容一律经由自有命令 read_text_file 返回。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "dialog:allow-open",
    "log:default",
    "store:default"
  ]
}
